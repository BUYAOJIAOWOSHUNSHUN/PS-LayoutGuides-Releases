{
  "manifestVersion": 5,
  "id": "com.local.layout-guides",
  "name": "品牌版式标准规范PS插件",
  "version": "1.9",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "27.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://api.github.com",
        "https://github.com",
        "https://codeload.github.com",
        "https://objects.githubusercontent.com",
        "https://raw.githubusercontent.com"
      ]
    },
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": [
        ".zip"
      ]
    },
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "layoutPanel",
      "label": {
        "default": "品牌版式标准规范PS插件"
      },
      "minimumSize": {
        "width": 420,
        "height": 400
      },
      "maximumSize": {
        "width": 420,
        "height": 2560
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 880
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 880
      }
    }
  ]
}

{
  "manifestVersion": 5,
  "id": "com.local.layout-guides",
  "name": "品牌版式标准规范PS插件",
  "version": "2.1.1",
  "main": "index.html",
  "theme": "dark",
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "assets/icon-line.png",
      "scale": [1, 2],
      "theme": ["all"]
    }
  ],
  "host": {
    "app": "PS",
    "minVersion": "27.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://api.github.com",
        "https://github.com",
        "https://codeload.github.com",
        "https://objects.githubusercontent.com",
        "https://raw.githubusercontent.com"
      ]
    },
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": [
        ".zip",
        ".bat"
      ]
    },
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "layoutPanel",
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "assets/icon-line-panel.png",
          "scale": [1, 2],
          "theme": ["all"]
        }
      ],
      "label": {
        "default": "品牌版式标准规范PS插件"
      },
      "minimumSize": {
        "width": 400,
        "height": 400
      },
      "maximumSize": {
        "width": 520,
        "height": 2560
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 880
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 880
      }
    }
  ]
}
